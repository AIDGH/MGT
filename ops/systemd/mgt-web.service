[Unit]
Description=MGT Next.js website and admin
After=network.target mgt-api.service
[Service]
User=mgt
Group=mgt
WorkingDirectory=/opt/mgt/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
Environment=INTERNAL_API_URL=http://127.0.0.1:4001
ExecStart=/usr/local/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mgt/current/.next
UMask=0027
[Install]
WantedBy=multi-user.target
