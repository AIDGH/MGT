generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Admin {
  id                 String @id @default(uuid())
  username           String @unique
  passwordHash       String
  mustChangePassword Boolean @default(true)
  createdAt          DateTime @default(now())
  sessions           Session[]
}
model Session {
  id        String @id
  adminId   String
  admin     Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@index([adminId])
}
model Category {
  id        String @id @default(uuid())
  slug      String @unique
  nameFa    String
  nameEn    String
  version   Int @default(1)
  products  Product[]
}
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
model Product {
  id            String @id @default(uuid())
  slug          String @unique
  sku           String @default("")
  nameFa        String
  nameEn        String
  descriptionFa String @default("")
  descriptionEn String @default("")
  specsFa       String @default("")
  specsEn       String @default("")
  images        String[]
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status        ProductStatus @default(DRAFT)
  version       Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([status, createdAt])
  @@index([categoryId])
}
model Slide {
  id        String @id @default(uuid())
  titleFa   String
  titleEn   String
  captionFa String @default("")
  captionEn String @default("")
  image     String
  href      String @default("")
  position  Int @default(0)
  active    Boolean @default(true)
  version   Int @default(1)
  createdAt DateTime @default(now())
}
model SiteContent {
  id        String @id @default("main")
  data      Json
  version   Int @default(1)
  updatedAt DateTime @updatedAt
}
model Media {
  id        String @id @default(uuid())
  url       String @unique
  name      String
  size      Int
  createdAt DateTime @default(now())
}
